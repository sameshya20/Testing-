# Application Settings
PROJECT_NAME=Test Case Generator Platform
DATABASE_URL=sqlite:///./test_generator.db

# Azure DevOps Integration Mode: 'mock' (default, no credentials needed) or 'real' (Microsoft REST APIs)
AZURE_DEVOPS_MODE=mock
AZURE_DEVOPS_ORG=DemoOrganization
AZURE_DEVOPS_PROJECT=TestCaseDemoProject
AZURE_DEVOPS_PAT=
# For real mode:
# AZURE_DEVOPS_MODE=real
# AZURE_DEVOPS_ORG=https://dev.azure.com/myorganization
# AZURE_DEVOPS_PROJECT=MyProject
# AZURE_DEVOPS_PAT=your_azure_devops_personal_access_token_here

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
